{
  "name": "olbos-lms",
  "version": "0.1.0",
  "private": true,
  "description": "OLBOS LMS — multi-tenant Learning, Training & Safety Compliance platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm --filter @olbos/api run build && pnpm --filter @olbos/worker run build",
    "build:all": "pnpm run build && pnpm --filter @olbos/web run build",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:all",
    "db:generate": "pnpm --filter @olbos/database run generate",
    "db:migrate": "pnpm --filter @olbos/database run migrate",
    "db:migrate:deploy": "pnpm --filter @olbos/database run migrate:deploy",
    "db:push": "pnpm --filter @olbos/database run push",
    "db:reset": "pnpm --filter @olbos/database run reset",
    "db:seed": "pnpm --filter @olbos/database run seed",
    "db:validate": "pnpm --filter @olbos/database run validate",
    "dev": "pnpm --parallel --filter @olbos/api --filter @olbos/web --filter @olbos/worker run dev",
    "dev:api": "pnpm --filter @olbos/api run dev",
    "dev:web": "pnpm --filter @olbos/web run dev",
    "dev:worker": "pnpm --filter @olbos/worker run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "dotenv": "16.4.7",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ],
    "overrides": {
      "deepmerge-ts": ">=8.0.0",
      "fast-uri@3": "3.1.7",
      "fast-uri@4": "4.1.4",
      "source-map-js": "1.2.2",
      "sharp": "0.35.5"
    }
  }
}
