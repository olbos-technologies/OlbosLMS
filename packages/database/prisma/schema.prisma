// ---------------------------------------------------------------------------
// OLBOS LMS — data model
//
// Conventions
//   * Every primary key is a UUID.
//   * Every tenant-owned table carries `organizationId` as its FIRST index
//     column so that tenant-scoped reads stay index-covered.
//   * Tenant-owned tables are enumerated in `src/tenancy.ts`; the tenant client
//     refuses to query a tenant-owned model without a tenant context.
//   * Historical rows (training records, grades, audit logs, certificates) are
//     never mutated in place by ordinary application flows — they are appended
//     to or superseded, so that a compliance audit can reconstruct history.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

