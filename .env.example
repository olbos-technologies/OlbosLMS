# ---------------------------------------------------------------------------
# OLBOS LMS — example environment. Copy to `.env` and fill in real values.
# NEVER commit a populated .env file. All secrets are read from the process
# environment and validated at boot by @olbos/config.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://olbos:olbos@localhost:5432/olbos_dev?schema=public
# Used only by the integration test suite; must be a throwaway database.
TEST_DATABASE_URL=postgresql://olbos:olbos@localhost:5432/olbos_test?schema=public

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- API ------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public origin of the API, used for certificate verification URLs.
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000

# --- Secrets (generate with: openssl rand -hex 32) ------------------------
# Signs session cookies. Rotating this invalidates all sessions.
SESSION_SECRET=replace-me-with-64-hex-characters-minimum-32-bytes-of-entropy
# Signs certificate verification tokens.
CERTIFICATE_SIGNING_SECRET=replace-me-with-64-hex-characters-minimum-32-bytes-of-entropy

SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60

# --- Web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=OLBOS LMS

# --- Object storage (S3 compatible) --------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=olbos-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=104857600

# --- Email ----------------------------------------------------------------
MAIL_DRIVER=log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="OLBOS LMS <no-reply@olbos.local>"

# --- AI (optional; AI features stay disabled while unset) -----------------
AI_DRIVER=null
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Billing (optional) ---------------------------------------------------
BILLING_DRIVER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
